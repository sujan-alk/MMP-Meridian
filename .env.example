# ============================================================
# ALKIMI MM Bot — Environment Variables
# Copy this file to .env for local development.
# On Railway: set these as environment variables in the dashboard.
# NEVER commit .env to git.
# ============================================================

# --- Exchange Credentials ---

# KuCoin (requires passphrase in addition to key/secret)
KUCOIN_API_KEY=your_kucoin_api_key
KUCOIN_API_SECRET=your_kucoin_api_secret
KUCOIN_PASSPHRASE=your_kucoin_passphrase

# Gate.io
GATE_API_KEY=your_gate_api_key
GATE_API_SECRET=your_gate_api_secret

# MEXC
MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret

# Kraken
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret

# --- Runtime Settings ---

# IMPORTANT: Set to "true" to place real orders. Default is false (dry-run).
LIVE_MODE=false

# --- C++ Connector Switch ---
# Set to "true" to use the C++ WebSocket connectors instead of CCXT for all exchanges.
# Requires exchange/cpp/ to be built first:
#   cd exchange/cpp/build && cmake .. && make -j$(nproc) && make install
# Individual exchanges can override this in bot.json via "use_cpp_connector": true/false.
# Revert to CCXT at any time by setting this to "false" — no restart required.
USE_CPP_CONNECTOR=false

# API server port
PORT=8000

# Supabase / PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
# Use the TRANSACTION POOLER URI (port 6543):
#   Supabase Dashboard > Project Settings > Database > Connection string > Transaction
SUPABASE_DB_URL=postgresql://postgres.your-ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# Schema for prod tables (default: mm_bot). Tests auto-override to mm_bot_test.
# One Supabase project can host both prod and test safely via separate schemas.
# DB_SCHEMA=mm_bot

# Path to bot config file
BOT_CONFIG_PATH=bot.json

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: Slack or Discord webhook URL for Q-Switch emergency alerts
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional: API key to protect control endpoints (pause/resume/emergency_stop/config).
# If unset, endpoints are open. Recommended for any non-localhost deployment.
# API_KEY=your-secret-api-key

# --- Testing ---
# Postgres connection string for pytest. Can reuse the prod URL safely — tests
# operate on the mm_bot_test schema (set automatically by tests/conftest.py).
# TEST_DATABASE_URL=postgresql://postgres.your-ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres
